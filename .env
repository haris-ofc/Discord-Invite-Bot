DISCORD_TOKEN=Your Bot Token Here

# Accounts younger than this many days are counted as "fake" joins
FAKE_ACCOUNT_AGE_DAYS=14

# --- Bot presence (optional) ---
# Status: online | idle | dnd | invisible
BOT_STATUS=idle
# Activity type: playing | watching | listening | competing | streaming
BOT_ACTIVITY_TYPE=playing
# Activity text (leave empty for no activity)
BOT_ACTIVITY_TEXT=YOUR SERVER INVITES
# Only used when BOT_ACTIVITY_TYPE=streaming (Twitch or YouTube link)
BOT_STREAM_URL=https://twitch.tv
